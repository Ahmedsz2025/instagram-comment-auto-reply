# Meta credentials. These values must never use a NEXT_PUBLIC_ prefix.
META_APP_SECRET=replace-with-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-verify-token
META_INSTAGRAM_ACCESS_TOKEN=replace-with-instagram-user-access-token
META_INSTAGRAM_ACCOUNT_ID=replace-with-instagram-professional-account-id
META_GRAPH_API_VERSION=v26.0

# Matching is case-insensitive. The first configured matching phrase wins.
INSTAGRAM_KEYWORDS=guide,pricing,details
INSTAGRAM_PRIVATE_REPLY_TEXT=Thanks for your comment! Here are the details you requested.

# Protects the dashboard. The webhook and health endpoints remain public.
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=replace-with-a-long-random-password
